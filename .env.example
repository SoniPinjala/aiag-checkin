# TEMPLATE ONLY — every value here must stay a placeholder.
# This file IS committed to git. Real values go in .env, which is
# gitignored. Filling this file in is the single easiest way to
# leak a key: it sits next to .env, looks fillable, and is the
# one of the pair that gets pushed.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Settings > API Keys > the "secret" key. On older projects this
# is called service_role. Either bypasses RLS, so treat it like a
# root password: .env only, never here, never in assets/.
SUPABASE_SERVICE_KEY=

EVENT_ID=aiag2026

# Must match events.checkin_token in the database. Generate with:
#   node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
CHECKIN_TOKEN=

SITE_URL=https://SoniPinjala.github.io/aiag-checkin/
